{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@private/*": [
        "./private/*",
        "./private-stub/*"
      ]
    }
  },
  "include": [
    "renderer/src/**/*",
    "shared/**/*",
    "private/renderer/**/*",
    "private-stub/renderer/**/*",
    "private/shared/**/*",
    "private-stub/shared/**/*"
  ]
}
